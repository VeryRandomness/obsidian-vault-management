{
	"name": "vr-vault-management",
	"version": "1.0.0",
	"description": "Obsidian plugin: bullet variants, color swatches, bulk property editing, PDF export, text covers and theme updates in one plugin.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "node tests/build.mjs && node tests/run.cjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "VeryRandomness",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@lezer/common": "^1.5.4",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"yaml": "^2.6.1"
	},
	"dependencies": {
		"html2canvas-pro": "^2.5.2",
		"jspdf": "^4.2.1"
	}
